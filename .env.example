API_ID=              # dari https://my.telegram.org
API_HASH=            # dari https://my.telegram.org
BOT_TOKEN=          # Token bot dari @BotFather
OWNER_ID=           # User ID owner, bisa lebih dari 1 pisah spasi. Contoh: 123456 789012
LOG_GROUP=          # ID group backup harian (bot harus admin di grup ini)
